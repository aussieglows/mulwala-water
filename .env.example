# --- Consulting P&L — environment ---
# Copy this file to `.env` and fill in the values, then run `npm run setup`.

# Local SQLite database file (created automatically on first `prisma db push`).
DATABASE_URL="file:./dev.db"

# Sign-in: the passcode you type on the login screen, and a random secret used to sign the
# session cookie. Change ADMIN_PASSCODE to your own. For SESSION_SECRET, paste any long random
# string (e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" ).
ADMIN_PASSCODE="change-me"
SESSION_SECRET="paste-a-long-random-string-here"

# AI extraction of invoices / revenue screenshots (Claude vision). Without this key, uploads still
# save and stay fully editable — they just won't auto-fill. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Base URL of the app (used to build OAuth redirect URIs). Localhost for dev; your real URL once
# deployed. No trailing slash.
APP_URL="http://localhost:3000"

# --- Email via Gmail (recommended) ---
# Connect a Google account to read forwarded receipts/revenue from Gmail labels. Create an OAuth
# client at https://console.cloud.google.com (APIs & Services → Credentials → OAuth client ID →
# "Web application"), enable the Gmail API, and add the redirect URI:  <APP_URL>/api/google/callback
# In the OAuth consent screen, add yourself as a Test user (no Google verification needed for personal use).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to <APP_URL>/api/google/callback
GOOGLE_REDIRECT_URI=""

# --- Legacy inbound-email webhook (optional; only if you ever use Postmark/SendGrid instead of Gmail) ---
# When set, forwarded receipts must hit /api/inbound?key=<this secret>.
INBOUND_SECRET=""

# --- Bank + investments via Plaid ---
# Sign up at https://dashboard.plaid.com and start in the free "sandbox" (fake bank logins) to test.
# Request the "Investments" product in the dashboard to link investment accounts.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Protects the cron endpoint (/api/cron/run) that runs Gmail + Plaid sync on a schedule after deploy.
CRON_SECRET=""
